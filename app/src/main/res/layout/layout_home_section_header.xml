<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:layout_marginBottom="12dp">

    <View
        android:id="@+id/indicator"
        android:layout_width="4dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_section_indicator" />

    <TextView
        android:id="@+id/text_section_title"
        style="@style/TextAppearance.Cricket.HeadlineMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@id/indicator"
        android:fontFamily="@font/oswald_regular"
        android:textColor="@color/white"
        android:textSize="20sp"
        tools:text="CRICKET" />

    <TextView
        android:id="@+id/btn_see_all"
        style="@style/TextAppearance.Cricket.LabelMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:text="SEE ALL >"
        android:textColor="@color/secondary" />

</RelativeLayout>
